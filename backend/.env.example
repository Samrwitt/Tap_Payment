PORT=8080
BASE_URL=http://localhost:8080
SQLITE_PATH=./data/payments.db

# Payment provider: tap | mock
PAYMENT_PROVIDER=mock

# Tap (test/live) secret key, ex: sk_test_...
TAP_SECRET_KEY=

# Optional: if Tap provides a distinct webhook secret; otherwise leave empty and TAP_SECRET_KEY will be used.
TAP_WEBHOOK_SECRET_KEY=

# Public URL that Tap will call (must be reachable from Tap in real usage)
TAP_WEBHOOK_URL=http://localhost:8080/api/payments/webhooks/tap

