PORT=8080
BASE_URL=http://localhost:8080
SQLITE_PATH=./data/payments.db

# Payment provider: mock | tap | chapa
PAYMENT_PROVIDER=mock

# Required for POST /api/payments/{id}/refund
ADMIN_API_KEY=dev-admin-key

# Tap (when PAYMENT_PROVIDER=tap)
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET_KEY=

# Chapa Ethiopia (when PAYMENT_PROVIDER=chapa)
CHAPA_SECRET_KEY=

# Optional override for provider webhook callback URL
WEBHOOK_URL=
